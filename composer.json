{
	"name": "infoaicinformatique/webmail",
	"description": "Nextcloud webmail app for OVH Hosted Exchange (Exchange Web Services)",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.1",
		"ext-curl": "*",
		"ext-dom": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Webmail\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Webmail\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.1"
		}
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml"
	}
}
